# Keya Studio Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
MONGO_URI=your_mongodb_atlas_uri_here
DB_NAME=studiospace

# JWT Secret for Cookie Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend (Client) URL - Vercel Deployment
CLIENT_URL=https://keya-studio-frontend.vercel.app

# Backend URL - Vercel Deployment (Used for OAuth callback)
BACKEND_URL=https://keya-studio-backend.vercel.app

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
